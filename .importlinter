[importlinter]
root_package = sensors

# ============================================================================
# Layered architecture
# ============================================================================
# Higher layers may import from lower ones, never the other way around.
# Modules listed on the same line are peers and must not import each other.
#
#   sensors.cli                              <- entry point
#   sensors.orchestration | sensors.tui      <- lifecycle/RPC and presentation
#                                               (peers; neither imports the other)
#   sensors.runners                          <- process management + parsing
#   sensors.persistence                      <- state file
#   sensors.config                           <- schema + paths (leaf)
#
# `exhaustive = false` lets us layer only the subpackages we care about.
# Other top-level helpers (e.g. sensors.time_util) are unconstrained.
# ----------------------------------------------------------------------------
[importlinter:contract:layers]
name = Top-down architecture layers
type = layers
exhaustive = false
layers =
    sensors.cli
    sensors.orchestration | sensors.tui
    sensors.runners
    sensors.persistence
    sensors.config

# ============================================================================
# Parser sub-layer rules
# ============================================================================
# Parsers are meant to be pure data transforms: tool output in,
# RunnerResult/ScoreInfo out. They must not depend on storage, and they must
# not depend on the runner that drives them. These two constraints sit
# *inside* the runners layer, so the layered contract above cannot express
# them on its own.
# ----------------------------------------------------------------------------

# Parsers receive their domain types (RunnerResult, ScoreInfo) by injection
# and must not reach into the storage layer for them.
[importlinter:contract:forbid-parsers-on-persistence]
name = Parsers must not depend on persistence
type = forbidden
source_modules =
    sensors.runners.parsers
forbidden_modules =
    sensors.persistence

# A parser is a pluggable transform. The driver/runner that calls it
# must remain invisible to the parser implementations.
[importlinter:contract:forbid-parsers-on-generic]
name = Parsers must not import GenericRunner
type = forbidden
source_modules =
    sensors.runners.parsers
forbidden_modules =
    sensors.runners.generic
